{
  "name": "city-hole",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "mobile:android": "npm run build && cap add android",
    "mobile:ios": "npm run build && cap add ios",
    "mobile:sync": "npm run build && cap sync",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "desktop:start": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --dir",
    "test:pacing": "RUN_PACING=1 VERIFY_PACING=1 TRIAL_CITIES=0,1,2,3 vitest run src/tests/pacingTrial.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/three": "^0.180.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "@electron/get": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "desktop/main.cjs",
  "description": "A stylized city swallowing game",
  "author": "City Hole",
  "build": {
    "appId": "com.cityhole.game",
    "productName": "City Hole",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "linux": {
      "category": "Game"
    },
    "npmRebuild": false
  }
}
