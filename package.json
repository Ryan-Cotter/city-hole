{
  "name": "city-hole",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "mobile:android": "npm run build && cap add android",
    "mobile:ios": "npm run build && cap add ios",
    "mobile:sync": "npm run build && cap sync",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
